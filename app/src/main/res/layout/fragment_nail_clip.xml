<?xml version="1.0" encoding="utf-8"?>
<!-- Nail-clipping mini-game popup (Task 6). Shown as a Fragment layered over the game so it can be
    lifted out and reused without touching the tray task system. The panel, its content and the
    close button are grouped in one fixed-size card, so the button always sits on the panel corner
    instead of drifting with the screen size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/nail_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/scrim" />

    <FrameLayout
        android:id="@+id/nail_card"
        android:layout_width="312dp"
        android:layout_height="452dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/nail_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/bg_panel" />

        <LinearLayout
            android:id="@+id/nail_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/nail_title"
                android:textColor="@color/text_title"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nail_subtitle"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/nail_foot_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

            <ImageView
                android:id="@+id/nail_foot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/baby_foot"
                app:layout_constraintWidth_percent="0.720"
                app:layout_constraintHeight_percent="0.880"
                app:layout_constraintHorizontal_bias="0.5000"
                app:layout_constraintVertical_bias="1.0000"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/nail_long"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintWidth_percent="0.105"
                app:layout_constraintHeight_percent="0.155"
                app:layout_constraintHorizontal_bias="0.2765"
                app:layout_constraintVertical_bias="0.2870"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/nail_long"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintWidth_percent="0.105"
                app:layout_constraintHeight_percent="0.155"
                app:layout_constraintHorizontal_bias="0.4106"
                app:layout_constraintVertical_bias="0.1864"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/nail_long"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintWidth_percent="0.105"
                app:layout_constraintHeight_percent="0.155"
                app:layout_constraintHorizontal_bias="0.5615"
                app:layout_constraintVertical_bias="0.1627"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/nail_long"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintWidth_percent="0.100"
                app:layout_constraintHeight_percent="0.145"
                app:layout_constraintHorizontal_bias="0.7056"
                app:layout_constraintVertical_bias="0.2251"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/nail_long"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintWidth_percent="0.090"
                app:layout_constraintHeight_percent="0.130"
                app:layout_constraintHorizontal_bias="0.8242"
                app:layout_constraintVertical_bias="0.3333"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/nail_clippers"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/tool_nail_clipper"
                android:alpha="0.0"
                app:layout_constraintWidth_percent="0.340"
                app:layout_constraintHeight_percent="0.340"
                app:layout_constraintHorizontal_bias="0.5000"
                app:layout_constraintVertical_bias="0.9545"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/nail_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/nail_done"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:alpha="0.45"
                android:background="@drawable/bg_button_green"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/nail_done"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/nail_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_margin="2dp"
            android:clickable="true"
            android:contentDescription="@string/cd_close"
            android:focusable="true"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <com.gamek.daycare.view.ParticleEmitterView
        android:id="@+id/nail_fx"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
